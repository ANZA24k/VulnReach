{
  "name": "vulnreach",
  "version": "1.0.0",
  "description": "Evidence-bound vulnerability applicability reviews on GenLayer",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
